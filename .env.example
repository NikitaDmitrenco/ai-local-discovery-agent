# ==============================================================================
# AI Local Discovery Agent - Environment Configuration Template
# ==============================================================================

# LLM Providers (At least one can be configured; fallback to mock when absent)
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Place & Search Providers
# When empty, application seamlessly falls back to high-fidelity Mock Discovery Engine
GOOGLE_PLACES_API_KEY=
SERPER_API_KEY=

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_CITY="Chișinău"
NEXT_PUBLIC_DEFAULT_LAT=47.0245
NEXT_PUBLIC_DEFAULT_LNG=28.8322

# Demo / Mock Mode ('true' enables realistic mock providers, 'false' forces live APIs)
NEXT_PUBLIC_DEMO_MODE=true
